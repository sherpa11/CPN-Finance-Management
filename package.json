{
  "name": "cpn-raja-finance-system",
  "version": "1.0.0",
  "description": "CPN Raja Finance Management System - Production Ready Financial Portal",
  "scripts": {
    "build": "cd frontend && npm install --include=dev && npm run build",
    "vercel-build": "cd frontend && npm install --include=dev && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "clear-demo": "cd backend && npm run clear-demo",
    "backup": "cd backend && npm run backup",
    "restore": "cd backend && npm run restore",
    "provision-admin": "cd backend && npm run provision-admin",
    "test": "cd backend && npm test",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "start": "cd backend && npm start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^9.12.2",
    "morgan": "^1.12.1",
    "uuid": "^14.0.3"
  },
  "author": "CPN Raja Finance Management System",
  "license": "UNLICENSED",
  "private": true
}
