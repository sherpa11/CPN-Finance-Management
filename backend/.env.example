# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas in Production or Local MongoDB in Development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cpn_raja_vatti_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Business Details
APP_NAME="CPN RAJA – VATTI MANAGEMENT SYSTEM"
BUSINESS_OWNER="CPN Raja"
TIMEZONE="Asia/Kolkata"
DEFAULT_REMINDER_DAYS=3
