# ==============================================================================
# CPN RAJA – FINANCE MANAGEMENT SYSTEM
# Backend Environment Configuration Template
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
TIMEZONE=Asia/Kolkata

# Database Connection (MongoDB Atlas in Production / Local MongoDB in Development)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/cpn_raja_vatti_db?retryWrites=true&w=majority

# Test Database Connection (Isolated from Production / Development)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/cpn_raja_test_db

# Security & JWT Authentication (Mandatory: Minimum 32-character high-entropy secret)
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins, or * for open access
CORS_ORIGIN=https://cpn-finance-management.vercel.app,http://localhost:5173

# Business Branding & Defaults
APP_NAME="CPN RAJA – FINANCE MANAGEMENT SYSTEM"
BUSINESS_OWNER="CPN Raja"
DEFAULT_REMINDER_DAYS=3

# Initial Administrator Provisioning (Used only during initial setup: npm run provision-admin)
ADMIN_INITIAL_USERNAME=cpnraja
ADMIN_INITIAL_PASSWORD=replace_with_strong_production_password_min_8_chars
ADMIN_INITIAL_EMAIL=admin@cpnraja.com
ADMIN_INITIAL_FULLNAME="CPN Raja"
